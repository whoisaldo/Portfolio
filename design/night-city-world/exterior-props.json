{
 "version": 1,
 "note": "Generated by npm run world:assets (scripts/optimize-world.mjs, scripts/world-exterior-props.mjs). Not drawn by the site yet: draw world-<tier>-exterior-props.glb and read props-<tier>-batched.bin in place of props-<tier>.bin, both or neither, so each part is drawn once.",
 "files": {
  "world-<tier>-exterior-props.glb": "One node and mesh a batch, at the origin, world-space vertices (float32, no quantisation, no meshopt). Its material is a bare glTF material named as the kit's (NCW_<name>), to be dressed by that name as the props' own parts are.",
  "props-<tier>-batched.bin(.gz)": "props-<tier>.bin with the taken placements' records removed; every other record and the header's protos, districts and their order unchanged (count is the new length). No sectorRuns: every record is the street's."
 },
 "batchKey": "material name | vertex layout (attribute names and item sizes) | assetKind | source render layer mask. Different masks never share a batch.",
 "nodeExtras": {
  "sourceKind": "always \"prop\": drawn as a prop (uProp 1, or the prop's own shader), never the architecture's uProp 0",
  "sourceLayers": "the layer mask the instanced part had: 1, or 5 (1 | 1 << REFLECT_LAYER 2) for glow, neon_, lantern and the lit own materials (face, paper)",
  "visibilitySector": "always \"exterior\"",
  "shaderLocal": "true for a prop's own material (src/world/prop-surfaces.js), whose shader reads its prototype's frame: see attributes",
  "assetKind": "present only where the prototype's part had one",
  "runs": "[cell x, cell z, reach, first index, index count]: as props.js Baked's runs (12 m cells, row by row; reach in metres, already x0.65 on the phone; __near ornaments their own shorter reach)",
  "placements": "[props-<tier>.bin record, props-source.json instance, prototype (name__near for its ornament), part (its proto_ node), first index, index count]: one row per part per placement, so each placement's triangles are findable (for the light bake: props.js sourcesOf skips a placement standing over y 8)"
 },
 "attributes": {
  "POSITION": "float32 VEC3, world: the placement's matrix times the prototype's vertex, as props.js Baked.writeSteps sums it",
  "NORMAL": "float32 VEC3, world: the matrix's 3x3 times the prototype's normal, made a unit (Baked.writeSteps)",
  "TEXCOORD_0": "float32 VEC2, where the prototype has it, as it is",
  "COLOR_0": "float32 VEC3 or VEC4 (alpha kept), where the prototype has it, as it is",
  "_LOCAL_POSITION": "shaderLocal only. float32 VEC3: the prototype's vertex in its own frame, as the instanced draw's position attribute",
  "_LOCAL_NORMAL": "shaderLocal only. float32 VEC3: its normal in its own frame, as the instanced draw's normal attribute",
  "_INSTANCE_MATRIX_0": "shaderLocal only. float32 VEC4: column 0 of the placement's matrix, as three's instanceMatrix holds it (float32)",
  "_INSTANCE_MATRIX_1": "shaderLocal only. float32 VEC4: column 1",
  "_INSTANCE_MATRIX_2": "shaderLocal only. float32 VEC4: column 2",
  "_INSTANCE_MATRIX_3": "shaderLocal only. float32 VEC4: column 3, the placement's origin (x, y, z, 1)",
  "_DEAL": "shaderLocal only. float32 SCALAR: the placement's aDeal (0: no prototype a prop-deal.js rule deals is taken)"
 },
 "keptInstanced": "A prototype a prop-deal.js rule deals (its deal reads its neighbours), one with a part that blends (clearglass, halo), and one whose parts are not in the core GLB stay in props-<tier>-batched.bin, listed in keptInBox.",
