{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/*.js": { "maxDuration": 10 } },
  "rewrites": [
    { "source": "/go/:code", "destination": "/api/go?c=:code" },
    { "source": "/og.png", "destination": "/api/og" },
    { "source": "/", "destination": "/index.html" }
  ]
}
